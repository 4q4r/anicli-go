"alias":"ona"},"remote_ids":{"worldart_id":0,"shikimori_id":62750,"anidub_id":0,"anilibria_alias":"","myanimelist_id":62750,"kp_id":0,"worldart_type":"animation","sr_id":0},"top":{"category":1798,"global":10403},"blocked_in":[]},{"description":"Сотни лет люди живут в глубоких пещерах, в постоянном страхе перед землетрясениями и обвалами. В одной из таких подземных деревень живет мальчик Симон и его «духовный наставник» — молодой парень Камина. Камина верит, что наверху есть другой мир, без стен и потолков; его мечта — попасть туда. Но его мечты остаются пустыми фантазиями, пока в один прекрасный день Симон случайно не находит дрель... вернее, ключ от странного железного лица в толще земли. В этот же день происходит землетрясение, и потолок пещеры рушится — так начинается поистине эпическое приключение Симона, Камины и их компаньонов в новом для них мире: мире под открытым небом огромной Вселенной.","poster":{"fullsize":"//static.yani.tv/posters/full/1636793979.jpg","big":"//static.yani.tv/posters/full/1636793979.jpg","small":"//static.yani.tv/posters/full/1636793979.jpg","medium":"//static.yani.tv/posters/full/1636793979.jpg","huge":"//static.yani.tv/posters/full/1636793979.jpg","mega":"//static.yani.tv/posters/full/1636793979.jpg"},"title":"Гуррен-Лаганн","anime_url":"gurren-lagann","anime_id":463,"rating":{"average":9.09603898074941,"counters":6362,"kp_rating":8.5,"anidub_rating":0,"myanimelist_rating":8.65,"worldart_rating":8.9,"shikimori_rating":8.89900658453209},"genres":[{"title":"Сёнэн","url":"/catalog/category/senen","id":8,"alias":"senen"},{"title":"Драма","url":"/catalog/category/drama","id":15,"alias":"drama"},{"title":"Комедия","url":"/catalog/category/komediya","id":16,"alias":"komediya"},{"title":"Меха","url":"/catalog/category/meha","id":25,"alias":"meha"},{"title":"Пилотируемые роботы","url":"/catalog/category/pilotiruemye-roboty","id":27,"alias":"pilotiruemye-roboty"},{"title":"Приключения","url":"/catalog/category/priklyucheniya","id":32,"alias":"p